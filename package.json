{
  "name": "enterload3",
  "version": "1.3.0",
  "description": "Enterload — загрузчик видео на Electron + React + yt-dlp",
  "author": "Егор Балашов",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start:renderer": "cross-env NODE_ENV=development webpack serve --config webpack.renderer.config.js --env development",
    "start:electron": "wait-on tcp:3001 && cross-env NODE_ENV=development electron .",
    "dev": "npm run start:renderer",
    "electron": "npm run start:electron",
    "start": "concurrently -k -n web,app \"npm run start:renderer\" \"npm run start:electron\"",
    "preview": "npm run build:renderer && electron .",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build": "node scripts/release.js",
    "build:dir": "node scripts/release.js --dir",
    "update:yt-dlp": "node node_modules/yt-dlp-exec/scripts/postinstall.js",
    "release": "node scripts/release.js --publish",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.js",
    "check:locales": "node scripts/check-locales.js"
  },
  "build": {
    "appId": "com.enterload.app",
    "productName": "Enterload",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/i18n.js",
      "src/locales/*.json",
      "dist/**/*",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/yt-dlp-exec/bin/",
        "to": "bin",
        "filter": [
          "yt-dlp*"
        ]
      },
      {
        "from": "vendor/ffmpeg",
        "to": "ffmpeg"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Enterload",
      "artifactName": "Enterload-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Enterload-${version}-portable.exe"
    },
    "copyright": "© 2026 Егор Балашов · My Toolkit",
    "publish": [
      {
        "provider": "github",
        "owner": "Agrysif",
        "repo": "Enterload",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@fontsource-variable/inter": "^5.3.0",
    "babel-loader": "^10.0.0",
    "chart.js": "^4.4.9",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "html-webpack-plugin": "^5.6.3",
    "react": "^19.1.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.5.0",
    "style-loader": "^4.0.0",
    "wait-on": "^8.0.3",
    "webpack": "^5.99.8",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.1",
    "yt-dlp-exec": "^1.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Agrysif/Enterload.git"
  }
}
